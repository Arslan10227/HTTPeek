<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 SSL / TLS Certificate Authority"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Install HTTPeek Root CA certificate to enable full HTTPS decryption on your device."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Hash & Root Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/divider"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="System Subject Hash:"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCertHash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="8c0ea220.0"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRootStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⚡ Root Status: Checking..."
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Status Bar -->
        <TextView
            android:id="@+id/tvCertStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/search_bg"
            android:padding="10dp"
            android:text="Select an installation method below:"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <!-- 5 Tiers List -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Tier 1: User KeyChain -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallKeyChain"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="1. Install via Android KeyChain (User Store)"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_dialog_info" />

            <!-- Tier 2: Magisk / Root Module -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallMagiskRoot"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="2. Install System CA via Root / Magisk Module"
                android:textSize="12sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_upload" />

            <!-- Tier 3: Downloads Folder -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDownloads"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="3. Save .CRT to Device Downloads Folder"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_save"
                app:strokeColor="@color/divider" />

            <!-- Tier 4: Security Settings -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSecuritySettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:paddingVertical="12dp"
                android:text="4. Open Android Security &amp; CA Settings"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_preferences"
                app:strokeColor="@color/divider" />

            <!-- Tier 5: ADB Command -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyAdbScript"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:text="5. Copy One-Line ADB Root Command"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_share" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
