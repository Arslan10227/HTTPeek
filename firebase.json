{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  },
  "auth": {
    "authorizedDomains": [
      "httpeek.onemanbyte.cc",
      "httpeek.firebaseapp.com",
      "localhost",
      "wails.localhost",
      "127.0.0.1"
    ],
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "HTTPeek",
        "supportEmail": "arslanameen10227@gmail.com"
      }
    }
  }
}
